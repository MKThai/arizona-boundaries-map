meta {
  name: Get Officials by Branch
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/officials/branch/:branch
  body: none
  auth: none
}

params:path {
  branch: executive
}

docs {
  Filter officials by government branch.
  Known values: `executive`, `legislative`.
}

tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Response is an array", function() {
    expect(res.getBody()).to.be.an("array");
  });
}
