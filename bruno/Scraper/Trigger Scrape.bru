meta {
  name: Trigger Scrape
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/scraper/trigger
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {}
}

docs {
  Manually triggers the multi-source Arizona officials scrape.
  Fetches Congress YAML, Open States CSV/YAML, and local executive supplement.
  Each source replaces only its own rows in the database.
}

tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Response has status field", function() {
    expect(res.getBody().status).to.be.oneOf(["success", "error"]);
  });
}
