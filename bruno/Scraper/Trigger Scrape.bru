meta {
  name: Trigger Scrape
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/scraper/trigger
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {}
}

docs {
  Manually triggers the Open States Arizona legislator scrape.
  Deletes existing openstates-sourced officials and inserts fresh legislative data.
  Does not affect manually seeded executive officials.
}

tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Response has status field", function() {
    expect(res.getBody().status).to.be.oneOf(["success", "error"]);
  });
}
